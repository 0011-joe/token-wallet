# npm 7+ 强制校验 peer 依赖：next-auth@4.24.15 声明了 peerOptional nodemailer@"^7.0.7"，
# 而本项目直接依赖 nodemailer@^9（lib/email/mailer.ts 自己 createTransport，auth.ts 用自定义
# sendVerificationRequest）——next-auth 内置的 nodemailer 通路从未被使用，该 peer 冲突不影响运行，
# 但会让 `npm install` 直接 ERESOLVE 失败（Vercel 构建即挂在 module_not_found / npm install exited with 1）。
legacy-peer-deps=true

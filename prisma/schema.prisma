// token-wallet v2 Prisma schema（DEV-GUIDE §7 / PRD §8.2）
// 数据库：云 Postgres（Neon）；金额一律 Decimal(18,9)（红线 #1，领域层禁 float）。
// v1 → v2 破坏性升级：ApiKey→Credential、BalanceSnapshot 结构变更、幂等键升级；
// 旧表在 migration 中改名为 *Legacy 保留，由 scripts/migrate-v1-to-v2.ts 搬数并回填。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js 模型（沿用 v1） ──
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  keys          Credential[]
  alerts        AlertSetting?
  alertOverrides AlertOverride[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── 平台与凭证 ──

enum Provider {
  deepseek
  kimi
  volcengine
}

enum CredentialKind {
  bearer
  aksk
}

enum BalanceMode {
  native
  derived
  manual
}

// 凭证（v1 ApiKey 泛化）：bearer 单段 key；aksk 两段 ak+sk。
// 密文统一 AES-256-GCM JSON 信封（规格卡 C，双格式兼容旧裸串密文）。
model Credential {
  id            String           @id @default(cuid())
  userId        String
  provider      Provider
  kind          CredentialKind
  region        String? // Kimi: v2.0 固定 'cn'；'intl' 为 v2.1 预留；其余 null
  label         String // 用户备注名
  secretCipher  Bytes // 加密信封 JSON：{"key":"sk-.."} 或 {"ak":"..","sk":".."}
  iv            Bytes
  authTag       Bytes
  keyVersion    Int              @default(1) // 密钥版本位（FR-7，轮换工具 v2.1）
  hint          String // 脱敏标识：last4 / AK 前缀+尾4 / 火山 AccountID
  meta          Json? // 非敏感附加：火山 AccountID 等
  isActive      Boolean          @default(true)
  failCount     Int              @default(0) // 连续失败次数
  lastStatus    String? // OK | INVALID | FORBIDDEN_SCOPE | RATE_LIMITED | ERROR
  lastSuccessAt DateTime?
  createdAt     DateTime         @default(now())
  snapshots     BalanceSnapshot[]
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, hint])
}

// 余额快照（归一化后）：available 为统一主指标（Decimal 字符串纪律）。
model BalanceSnapshot {
  id           String     @id @default(cuid())
  credentialId String
  provider     Provider
  mode         BalanceMode
  fetchedAt    DateTime
  currency     String // CNY | USD，分币种不混算
  available    Decimal    @db.Decimal(18, 9) // 统一主指标：可用余额
  breakdown    Json // {cash,granted,voucher,creditLimit,frozen,arrears}，缺项不出现
  raw          Json? // 原始响应（脱敏）留存
  isAvailable  Boolean
  ok           Boolean    @default(true) // 本次拉取是否成功
  stale        Boolean    @default(false) // 最近拉取失败、展示上次成功值的标记
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, provider, fetchedAt])
  @@index([provider, fetchedAt])
}

// ── 用量（FR-4：按平台；幂等键 [userId, provider, month]） ──

model UsageImport {
  id         String       @id @default(cuid())
  userId     String
  provider   Provider
  month      String // YYYY-MM，幂等键组成部分
  fileName   String
  importedAt DateTime     @default(now())
  currency   String? // 来自 cost CSV（CNY | USD 等），null=未导入 cost 文件
  rows       ModelUsage[]

  @@unique([userId, provider, month])
}

// 按 M1 探针定型的官方 CSV 长表：一行 = 模型×Key×type×单价 的聚合
model ModelUsage {
  id        String      @id @default(cuid())
  importId  String
  provider  Provider // 平台冗余（与 UsageImport.provider 一致）
  model     String
  apiKeyRef String? // CSV 内分 Key 标识（官方已打码）
  type      String // input_cache_hit_tokens | input_cache_miss_tokens | output_tokens | request_count
  unitPrice Decimal?    @db.Decimal(18, 9) // 每 token 单价；request_count 无价格
  amount    Int // token 数或请求次数
  cost      Decimal     @db.Decimal(18, 9) // price×amount 合计；request_count 为 0
  import    UsageImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
}

// ── 告警（FR-5：全局默认 + 平台/凭证覆盖；去重键业务唯一 + 时间窗） ──

model AlertSetting {
  userId              String @id
  lowBalanceThreshold Decimal @default(20) @db.Decimal(18, 9)
  failThresholdN      Int    @default(3)
  emailEnabled        Boolean @default(true)
  inappEnabled        Boolean @default(true)
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 平台/凭证级覆盖：provider 与 credentialId 均空 = 全局（应用层保证唯一，不做 DB 强制）
model AlertOverride {
  id                   String    @id @default(cuid())
  userId               String
  provider             Provider?
  credentialId         String?
  lowBalanceThreshold  Decimal?  @db.Decimal(18, 9)
  failThresholdN       Int?
  emailEnabled         Boolean?
  inappEnabled         Boolean?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, credentialId])
}

model AlertEvent {
  id           String   @id @default(cuid())
  userId       String
  provider     Provider
  credentialId String?
  type         String // LOW_BALANCE | ARREARS | CREDENTIAL_FAILED | UNAVAILABLE
  message      String
  dedupKey     String // 业务唯一键（type:credential 等），频控用时间窗判断（弃用 v1 复合唯一）
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

/// 邮箱登录验证码（OTP）：只存哈希，10 分钟过期，最多试 5 次
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

// ── v2.1-alpha：计价 / 用量事实 / 预算 / 采集设备 ──

enum UsageSource {
  csv_official
  host_measured
  derived_estimate
}

/// 单价（每 1M token）；只追加不修改（D8）
model Price {
  id            String   @id @default(cuid())
  provider      String
  model         String
  effectiveFrom DateTime
  currency      String
  input         Decimal  @db.Decimal(18, 9)
  output        Decimal  @db.Decimal(18, 9)
  cacheHit      Decimal? @db.Decimal(18, 9)
  cacheMiss     Decimal? @db.Decimal(18, 9)
  reasoning     Decimal? @db.Decimal(18, 9)
  sourceUrl     String
  checkedAt     DateTime
  note          String?

  @@unique([provider, model, effectiveFrom, currency])
  @@index([provider, model, effectiveFrom])
}

/// 峰谷窗口；倍率相对 Price 基价（空闲价）
model PriceWindow {
  id            String   @id @default(cuid())
  provider      String
  label         String
  effectiveFrom DateTime
  weekdayMask   Int
  startMinute   Int
  endMinute     Int
  tz            String   @default("Asia/Shanghai")
  multiplier    Decimal  @db.Decimal(6, 3)
  sourceUrl     String
  checkedAt     DateTime

  @@index([provider, effectiveFrom])
}

/// 日粒度用量事实（精度标签强制）
model UsageDaily {
  id              String      @id @default(cuid())
  userId          String
  provider        String
  model           String
  date            DateTime    @db.Date
  tz              String      @default("Asia/Shanghai")
  source          UsageSource
  inputTokens     BigInt      @default(0)
  outputTokens    BigInt      @default(0)
  cacheHitTokens  BigInt      @default(0)
  cacheMissTokens BigInt      @default(0)
  reasoningTokens BigInt      @default(0)
  requests        Int         @default(0)
  cost            Decimal?    @db.Decimal(18, 9)
  costComplete    Boolean     @default(false)
  currency        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, provider, model, date, source])
  @@index([userId, date])
  @@index([userId, provider, date])
}

/// 采集设备（每设备独立 key，可吊销）
model IngestDevice {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// ingest 幂等/防重放审计
model UsageIngest {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String?
  nonce       String    @unique
  source      String
  receivedAt  DateTime  @default(now())
  payloadHash String
  batchCount  Int
  accepted    Int
  rejected    Int

  @@index([userId, receivedAt])
}

enum BudgetPeriod {
  day
  month
  custom
}

enum BudgetScope {
  global
  provider
  modelPattern
}

model Budget {
  id              String       @id @default(cuid())
  userId          String
  scope           BudgetScope  @default(global)
  provider        String?
  modelPattern    String?
  period          BudgetPeriod @default(month)
  windowStart     DateTime?
  windowEnd       DateTime?
  amount          Decimal      @db.Decimal(18, 6)
  currency        String
  warnPct         Int          @default(80)
  criticalPct     Int          @default(100)
  runwayAlertDays Int?         @default(3)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  @@index([userId, isActive])
}
